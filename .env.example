# Copy to server/.env for local development
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=small_web_reader
# Set this to a long random value in production; used to hash abuse-control IP signals.
ABUSE_HASH_SALT=small_reader_secret_salt_replace_in_production
# Authentication Security (optional override - random bytes generated automatically if unset)
AUTH_SESSION_SECRET=replace_with_a_64_character_random_hex_string_in_production
# Optional OAuth Configuration (leave empty for email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
